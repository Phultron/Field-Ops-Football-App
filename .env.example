# Copy this file to .env.local for local development, or set these as
# environment variables in your Vercel project settings (Production + Preview).
# Never commit real values — this file only documents the required keys.

# --- Snowflake connection (service account, password auth) ---
# Use a dedicated, low-privilege service user scoped to read only the tables
# this app queries. MFA must be disabled for this user (password auth is
# non-interactive).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# --- Site-wide login gate ---
# SITE_PASSWORD: the shared password required to access the app.
# AUTH_SECRET: a long random string used to sign the session cookie.
#   Generate one with: openssl rand -hex 32
SITE_PASSWORD=
AUTH_SECRET=

# --- Rate limiting (Upstash Redis) ---
# Create a free database at https://upstash.com and paste its REST credentials
# here. If left unset, rate limiting is skipped (middleware fails open on this
# specific check only — auth is unaffected).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Data source switch ---
# "snowflake" (default, or unset): query Snowflake directly for roster + metrics.
# "airtable": read a pre-synced Airtable base instead (see
#   scripts/sync-gridiron-to-airtable.ts, local-only and gitignored). Use this
#   for a private deployment that shouldn't query PROD directly.
DATA_SOURCE=

# --- Airtable (only needed when DATA_SOURCE=airtable) ---
# Create a Personal Access Token at https://airtable.com/create/tokens with
# data.records:read/write and schema.bases:read/write scopes, scoped to just
# this base.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_ROSTER_TABLE=ROSTER
AIRTABLE_METRICS_TABLE=DAILY_METRICS
